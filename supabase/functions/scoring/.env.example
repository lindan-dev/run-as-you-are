# Kopiera till .env (gitignorad) för lokal utveckling med
# `supabase functions serve scoring --env-file supabase/functions/scoring/.env`.
# I produktion (efter `supabase functions deploy`) sätts dessa automatiskt
# av Supabase — inget att fylla i där.

SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=hämta-från-"supabase status"-output-lokalt
